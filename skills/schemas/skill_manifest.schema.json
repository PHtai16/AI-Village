{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Village SKILL.md Frontmatter Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "id",
    "name",
    "version",
    "description",
    "category",
    "author",
    "maintainer",
    "status",
    "requirements"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{2,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9_]{2,64}$"
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "maintainer": {
      "type": "string",
      "enum": ["it", "process", "qa"]
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "CANDIDATE",
        "UNDER_REVIEW",
        "APPROVED",
        "REJECTED",
        "DEPRECATED",
        "DISABLED"
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools"],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^tools\\.[a-z0-9_]+\\.[a-z0-9_]+$"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "min_engine_tier": {
          "type": "string",
          "enum": ["flash", "pro", "code"]
        }
      }
    }
  }
}
