# ==========================================
# AI Village — Environment Configuration Template
# ==========================================
# Sao chép tệp này thành `.env` trên máy cục bộ khi chạy các phase Runtime sau.
# Tuyệt đối không đưa khóa API, mật khẩu hoặc tệp `.env` thật vào Git.

# Môi trường vận hành (development | test)
AI_VILLAGE_ENV=development
AI_VILLAGE_LOG_LEVEL=INFO

# Đường dẫn lưu trữ cục bộ (giữ nguyên mặc định tương đối theo workspace)
AI_VILLAGE_WORKSPACE_DIR=./workspace
AI_VILLAGE_OUTPUT_DIR=./output
AI_VILLAGE_RUNTIME_DIR=./.runtime
AI_VILLAGE_DB_PATH=./.runtime/ai_village.db

# Engine mặc định dự kiến (chưa kích hoạt runtime trong Chặng A)
AI_VILLAGE_DEFAULT_ENGINE=antigravity
ANTIGRAVITY_CLI_PATH=

# Khóa API tùy chọn cho các Provider ngoài (để trống hoặc dùng placeholder)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Cấu hình API cục bộ dự kiến (Phase 12)
AI_VILLAGE_API_HOST=127.0.0.1
AI_VILLAGE_API_PORT=8000
